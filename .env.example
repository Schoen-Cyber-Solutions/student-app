# Copy to .env.local (gitignored) and fill in values for your machine.
# All EXPO_PUBLIC_* values are inlined into the JS bundle in plain text.
# Never put real secrets here.

# Backend API origin. Not a secret, but keep it centralized (constants/Api.ts).
# On a physical phone, "localhost" is the phone itself — use your Mac's LAN IP.
#   macOS: ipconfig getifaddr en0
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000

# (No dev-token fallback. Use real onboarding and SecureStore for sessions.)
