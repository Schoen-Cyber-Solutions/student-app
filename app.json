{
  "expo": {
    "name": "Study with Emy",
    "slug": "student-app-development",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/emy-icon.png",
    "scheme": "studentappdevelopment",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schoencybersolutions.studentapp",
      "appleTeamId": "5ZULG5R92Y"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/images/emy-icon.png",
        "monochromeImage": "./assets/images/emy-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/emy-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/emy-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#020617"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Study with Emy to access your photos so you can share images in chats.",
          "cameraPermission": "Allow Study with Emy to use your camera to take photos and share them in chats.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fbe0bfdf-ee91-4515-823d-a56757f84f98"
      }
    },
    "owner": "schoen-cyber-solutions"
  }
}
